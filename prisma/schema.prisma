// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Entry {
  id               String   @id @default(cuid())
  name             String   @default("")
  amount           Float
  date             DateTime
  type             String
  category         String
  note             String?
  method           String?
  groupId          String?
  seriesType       String?
  installmentNum   Int?
  installmentTotal Int?
  /// Which Account the money moved through (V1.28). Optional: entries logged
  /// before accounts existed, or paid by credit card, have none.
  accountId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id   String @id @default(cuid())
  name String
  type String

  @@unique([name, type])
}

model Budget {
  id       String @id @default(cuid())
  category String @unique
  limit    Float
}

model PaymentMethod {
  id   String @id @default(cuid())
  name String @unique
  /// Set up as a credit card (V1.28): purchases made with it group into
  /// monthly bills instead of leaving an account immediately. See lib/cards.ts.
  isCreditCard Boolean @default(false)
  /// 1-28, like the budget cycle start day.
  closingDay   Int?
  dueDay       Int?
}

model Investment {
  id             String       @id @default(cuid())
  name           String
  type           String // renda-fixa | fundo | acao | cripto | outro
  subtype        String?
  indexador      String? // prefixada | cdi-pct | cdi-plus | ipca-plus | selic-pct
  annualRate     Float?
  spread         Float?
  adminFee       Float?
  perfFee        Float?
  amountInvested Float
  startDate      DateTime
  maturityDate   DateTime?
  symbol         String?
  quantity       Float?
  purchaseRef    Float?
  expectedReturn Float?
  corretagem     Float?
  institution    String?
  notes          String?
  prices         PricePoint[]
  coupons        CouponPayment[]
  transactions   InvestmentTransaction[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PricePoint {
  id           String     @id @default(cuid())
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  investmentId String
  date         DateTime
  price        Float
  createdAt    DateTime   @default(now())

  @@unique([investmentId, date])
}

model CouponPayment {
  id           String     @id @default(cuid())
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  investmentId String
  date         DateTime
  amount       Float
  createdAt    DateTime   @default(now())
}
/// A dated buy or sell against a holding.
///
/// Optional by design: a holding with no transactions keeps behaving exactly as
/// it did before this model existed, valued from amountInvested/quantity and
/// startDate. Once transactions exist they take over, because they carry the one
/// thing those fields cannot - *when* each contribution happened.
model InvestmentTransaction {
  id           String     @id @default(cuid())
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  investmentId String
  date         DateTime
  /// "buy" | "sell". SQLite has no enums in Prisma, same as Entry.type.
  kind         String
  /// Cash moved, always positive; direction comes from kind.
  amount       Float
  /// Units bought or sold, for holdings priced per unit. Null for renda fixa.
  quantity     Float?
  notes        String?
  createdAt    DateTime   @default(now())
}

model ReferenceRates {
  id        String   @id @default("singleton")
  cdi       Float    @default(12.65)
  selic     Float    @default(13.25)
  ipca      Float    @default(5.5)
  updatedAt DateTime @updatedAt
}

// Singleton, same pattern as ReferenceRates. `cycleStartDay` is the day of
// the month every reporting period begins on (1 = plain calendar months).
// Capped at 28 in the UI so the boundary exists in every month — see
// CYCLE_START_DAY / clampCycleStartDay in src/lib/format.ts.
model AppSettings {
  id            String   @id @default("singleton")
  cycleStartDay Int      @default(10)
  // Brand accent name, not a hex — the palette lives in src/lib/theme.ts and
  // globals.css. Storing the name means a palette tweak restyles the app
  // instead of leaving a stale hex behind in the database.
  accentColor   String   @default("green")
  // UI language: "en" | "pt". Only the app's own copy follows this — the
  // owner's data (category names, entry names, payment methods) is never
  // translated, and currency stays pt-BR formatted since it's always BRL.
  language      String   @default("en")
  // Whether the Investments "Goal & projection" block is expanded. V1.21 kept
  // this per-visit because reading localStorage during the first render
  // disagrees with the server-rendered HTML, and the usual escape hatch is a
  // setState-in-effect, which this project lints against. A column is the
  // honest fix: the server knows the answer before it renders.
  goalCardOpen  Boolean  @default(true)
  // Automatic backups (V1.28). A dated JSON copy is written once a day and
  // before anything destructive. autoBackupDir null means "next to the
  // database file"; lastAutoBackupAt drives the once-a-day check.
  autoBackupEnabled Boolean   @default(true)
  autoBackupDir     String?
  autoBackupKeep    Int       @default(14)
  lastAutoBackupAt  DateTime?
  updatedAt     DateTime @updatedAt
}

// Singleton — a single savings goal for the Investments projector. Multiple
// goals are deliberately out of scope, so this follows the same
// `id: "singleton"` pattern as ReferenceRates/AppSettings rather than being a
// list. `expectedAnnualRate` is a DECIMAL (0.10 = 10% a.a.), unlike
// ReferenceRates which stores percentages — the projection math in
// src/lib/goal.ts works in decimals, and the form converts at the edge.
// `monthlyContribution` null means "use the recent average", computed from
// holdings rather than stored.
// Singleton. Holds the activated license, plus the timestamp the app was
// first opened so the trial can be counted without any network call.
//
// Deliberately NOT included in backup export/import: a backup file is meant to
// be portable between the owner's own machines, and carrying the licence inside
// it would turn "send me your backup" into a way to hand someone a paid copy.
// It also means restoring a backup never accidentally deactivates the app.
model License {
  id          String    @id @default("singleton")
  email       String?
  key         String?
  activatedAt DateTime?
  firstRunAt  DateTime  @default(now())
}

model InvestmentGoal {
  id                 String   @id @default("singleton")
  name               String   @default("Minha meta")
  targetAmount       Float
  targetDate         DateTime
  expectedAnnualRate Float    @default(0.1)
  monthlyContribution Float?
  updatedAt          DateTime @updatedAt
}

/// A place money actually sits: a bank account, a savings account, cash (V1.28).
///
/// openingBalance is what it held on openingDate. Only entries and transfers
/// dated on or after openingDate move the balance, so the owner can start
/// using accounts today without re-entering years of history.
///
/// Referenced by plain id (Entry.accountId, Transfer.*AccountId) rather than a
/// Prisma relation, matching how categories are referenced by name. Deleting
/// is blocked while anything points at it; archiving is the normal path.
model Account {
  id             String   @id @default(cuid())
  name           String   @unique
  /// "checking" | "savings" | "cash" | "other"
  kind           String   @default("checking")
  openingBalance Float    @default(0)
  openingDate    DateTime
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

/// Money moving between the owner's own places: never income or expense.
///
/// Either account to account, or account to investment. For the latter the
/// matching buy on the holding can be recorded too; its id is kept so deleting
/// the transfer removes that buy rather than leaving it behind.
model Transfer {
  id                      String   @id @default(cuid())
  date                    DateTime
  amount                  Float
  fromAccountId           String
  toAccountId             String?
  toInvestmentId          String?
  investmentTransactionId String?
  note                    String?
  createdAt               DateTime @default(now())

  @@index([date])
}

/// Paying (part of) a credit card bill. Not an expense: the purchases already
/// were. fromAccountId is optional so bills can be paid without using accounts.
model CardPayment {
  id              String   @id @default(cuid())
  paymentMethodId String
  /// "YYYY-MM" of the month the bill closes in.
  billKey         String
  amount          Float
  date            DateTime
  fromAccountId   String?
  createdAt       DateTime @default(now())

  @@index([paymentMethodId, billKey])
}

/// "Description contains X -> category" for CSV imports (V1.28). The pattern
/// is compared after normalizeMerchant(), so case, accents and digits don't
/// matter. Rules win over what the app learned from past entries.
model CategoryRule {
  id        String   @id @default(cuid())
  pattern   String
  /// "income" | "expense"
  type      String
  category  String
  createdAt DateTime @default(now())

  @@unique([pattern, type])
}

/// A big predictable bill saved for over time: IPVA, IPTU, insurance (V1.28).
/// savedAmount is kept up to date by hand. See lib/sinkingFunds.ts.
model SinkingFund {
  id            String   @id @default(cuid())
  name          String
  amount        Float
  dueDate       DateTime
  repeatsYearly Boolean  @default(true)
  savedAmount   Float    @default(0)
  /// Optional expense category the bill is paid from, for reference.
  category      String?
  createdAt     DateTime @default(now())
}
