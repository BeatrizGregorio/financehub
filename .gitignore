# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
# ...except the desktop app's icon. The .svg is the source; the .ico and .png
# are generated from it by `npm run icons` and committed so that packaging —
# including the Windows CI build — never has to rasterize anything.
!/build/icon.svg
!/build/icon.ico
!/build/icon.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# personal data — never commit
*.db
*.db-journal
financehub-backup-*.json

# electron desktop app build output
/release
/electron/node_modules

# personal Claude Code settings (not meant for the team/repo)
.claude/settings.local.json

# Automatic backups (V1.28) hold real financial data — never commit them.
/backups/
